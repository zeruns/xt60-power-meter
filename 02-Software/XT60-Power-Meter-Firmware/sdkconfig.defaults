# XT60 功率计固件——版本化默认配置
#
# 重要：sdkconfig 本身不纳入版本管理（见 .gitignore），
#       本文件才是"全新克隆后应该得到什么配置"的唯一依据。
#
# 如何生效（修改本文件后必须重新生成 sdkconfig）：
#   idf.py fullclean && rm sdkconfig && idf.py build
#   或（只改配置不改代码时）删除 sdkconfig 后执行 idf.py reconfigure

# ============================================================
# 目标芯片与模组
# ============================================================
CONFIG_IDF_TARGET="esp32s3"

# 模组型号：ESP32-S3-WROOM-1-N16R8
#   N16 → 16MB Flash（四线 QIO/DIO，非八线）
#   R8  → 8MB PSRAM（八线 Octal，占用 GPIO33~37）
# IDF 没有"模组型号"这个总开关，需由下面几项分别配置。

# ---------------- Flash（N16 = 16MB，四线） ----------------
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# N16R8 的 Flash 是四线器件，因此八线 Flash 选项必须关闭。
# （若误开 OCT_FLASH，IDF 会把 Flash 切到 OPI 八线模式去访问四线器件，直接无法启动）
# CONFIG_ESPTOOLPY_OCT_FLASH is not set
# 使用 QIO（四线）而不是 DIO（双线）：读带宽翻倍
# （80MHz 下 QIO ≈ 320Mbit/s，DIO ≈ 160Mbit/s），代码取指与 PSRAM 缓存
# 未命中时的 Flash 访问都受益。
#
# 关于"QIO 会不会和八线 PSRAM 冲突"——不会，原因有两点：
#   ① IDF 的约束是 QIO 仅与「八线 Flash（OCT_FLASH）」互斥，
#      与「八线 PSRAM」无关（见 components/esptool_py/Kconfig.projbuild
#      中 ESPTOOLPY_FLASHMODE_QIO 的 depends on !ESPTOOLPY_OCT_FLASH）；
#   ② Flash 与 PSRAM 挂在同一组 SPI0 总线上，靠片选（CS0/CS1）分时复用
#      数据线 D0~D3；八线 PSRAM 额外增加的 D4~D7 与 DQS 走 IO33~IO37，
#      与 Flash 的引脚不重叠。
# 注意：即使选了 QIO，esptool 烧录时仍以 DIO 写入 bootloader，
#       由 bootloader 在启动初始化阶段自行升级到四线模式（IDF 的既定行为）。
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ---------------- PSRAM（R8 = 8MB 八线） ----------------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
# 开机做一次 PSRAM 内存自检：耗时很短，但能及早发现焊接不良的模组，
# 对量产与售后排查很有价值。
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_USE_MALLOC=y
# 小于 16KB 的分配走内部 RAM，避免小对象分散在 PSRAM 上拖慢访问
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
# 预留 32KB 内部 RAM 专供"必须从内部 RAM 分配"的场景（DMA 描述符等）
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# 把 WiFi 与 LWIP 的收发缓冲放到 PSRAM：
# WiFi 缓冲占用很大（数十 KB），放内部 RAM 会挤占采样与 DMA 所需空间。
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# 允许把任务栈分配到 PSRAM（IDF 默认行为，保留）。
# 注意配置项名称：ESP-IDF v5.5 起已由 SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY
# 更名为 FREERTOS_TASK_CREATE_ALLOW_EXT_MEM，写旧名会得到
# "was replaced with ..." 警告（旧名仍作为兼容别名保留）。
# ⚠ 重要约束：中断服务程序（ISR）运行在当前任务的栈上，而 ISR 期间
#   不能访问 PSRAM（cache 未命中会异常）。因此凡是"可能被中断打断时
#   正在使用"的任务（如测量采样任务），其栈必须在内部 RAM，
#   创建时不要传 MALLOC_CAP_SPIRAM。
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

# ============================================================
# 性能
# ============================================================
# 主频 240MHz（ESP32-S3 最高）。测量运算、LVGL 渲染、WiFi 都受益。
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 缓存：32KB 指令缓存 + 64KB 数据缓存（ESP32-S3 的推荐配置）
# 说明：先前的配置被降为 16KB/32KB，会明显拖慢代码执行与 PSRAM 访问；
#       代价是占用更多内部 SRAM，但本工程内存预算充足（外部还有 8MB PSRAM）。
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y

# 编译优化 -O2（性能优先）。
# 默认的 -Og（调试优先）会让浮点运算与 LVGL 渲染慢很多；
# 本项目是测量仪器，性能优先。若要单步调试汇编级代码可临时改回。
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# 保留断言：能在开发阶段尽早暴露非法参数等问题，代价可接受
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y

# ============================================================
# FreeRTOS 与系统节拍
# ============================================================
CONFIG_FREERTOS_UNICORE=n
# 1kHz 节拍（1 tick = 1ms）：满足测量核 1ms 采样周期的定时精度要求。
# 代码中统一使用 pdMS_TO_TICKS()，因此改这里不会破坏延时逻辑。
CONFIG_FREERTOS_HZ=1000

# ============================================================
# 控制台 / 日志
# ============================================================
# 控制台走 USB-Serial/JTAG：烧录与看日志共用同一根 USB 线，无需额外串口模块。
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# 注意：请勿开启 nano 格式化（新版配置项名已加 LIBC_ 前缀）。
# nano 格式化不支持 %f，会导致日志里的浮点测量值打印为空或乱码。
# CONFIG_LIBC_NEWLIB_NANO_FORMAT is not set

# ============================================================
# 分区表与崩溃取证
# ============================================================
# 使用工程根目录的 partitions.csv（双 4MB OTA + 64KB coredump + 8MB storage）。
# 默认的 two_ota 方案应用区只有 1MB，接入 LVGL 与 WiFi 后必然不够用。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 把崩溃现场写入 Flash 的 coredump 分区。
# 野外设备不会有人守着串口，没有它就无法定位偶发崩溃。
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
# panic 后延迟 3 秒再复位：留出时间把完整日志打到串口（默认 0 秒会来不及打完）
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_SYSTEM_PANIC_REBOOT_DELAY_SECONDS=3

# 电源跌落检测：电池供电 + 大电流负载场景下很必要，
# 能在电压跌落导致 RAM 数据错乱之前先复位，避免"跑飞"。
# 注意配置项名：v5.5 起通用化为 ESP_BROWNOUT_DET（不再带芯片前缀）。
CONFIG_ESP_BROWNOUT_DET=y

# ============================================================
# 任务与网络资源（为 WiFi + 网页控制台预留）
# ============================================================
# WiFi 任务钉在 Core 0：与本工程"Core 0 = 交互与通信、Core 1 = 测量"
# 的划分一致，因此保持默认即可，无需修改。
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
# 系统事件任务默认栈 2304 字节，处理 WiFi 事件偏紧，加大到 4096
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
# 网页控制台需要 HTTP 服务端 + WebSocket 同时占用多个 socket，
# 默认 10 个偏少，加大到 16
CONFIG_LWIP_MAX_SOCKETS=16
